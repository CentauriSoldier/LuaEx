{
  "name": "luaex-tools",
  "version": "0.1.0",
  "description": "LuaEx LXC/LXE diagnostics, annotations, hover, completion and signature help for Pulsar.",
  "main": "./lib/main.js",
  "license": "Unlicense",
  "keywords": [
    "linter",
    "lua",
    "luaex",
    "lxc",
    "lxe"
  ],
  "engines": {
    "atom": ">=1.60.0 <3.0.0"
  },
  "providedServices": {
