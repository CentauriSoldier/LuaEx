        "2.0.0": "provideLinter"
      }
    },
    "autocomplete.provider": {
      "versions": {
        "2.0.0": "provideAutocomplete"
      }
    }
  },
  "scripts": {
    "test": "node test/run.js",
    "test:compiler": "node test/run.js --compiler"
  }
}
