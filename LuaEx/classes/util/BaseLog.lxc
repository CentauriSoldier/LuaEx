--[[!
@fqxn LuaEx.Classes.BaseLog
@desc Native LXC migration; explicit instance access and private class helpers.
!]]
namespace LuaEx.Classes
{
    class BaseLog
    {
        --[[!
        @fqxn LuaEx.Classes.BaseLog.helperWriteToFile
        @desc Private class helper migrated from writeToFile.
        !]]
        private static helperWriteToFile(other, tEntry)
        {
            local pro = other;
            local hFile = io.open(pro.path, "a")

            if hFile then
                --hFile:write(pro.dateTimeFunction()..' ['..tostring(tEntry.level).."]-> "..tEntry.message.."\n");
                hFile:write(tEntry.datetime.." ["..tostring(tEntry.level).."] "..tEntry.message.."\n");
                hFile:close();
            end
        }

        private static eLevels = enum("BaseLog.LEVEL", {"CRITICAL", "ERROR", "WARNING", "INFO", "DEBUG", "TRACE",}, nil, true);

        --[[!
        @fqxn LuaEx.Classes.BaseLog.helperCreateNewEntryTable
        @desc Private class helper migrated from createNewEntryTable.
        !]]
        private static helperCreateNewEntryTable()
        {
            return {
                datetime            = "",
                hasBeenCommitted    = false, --track which entries have been written to file
                level               = BaseLog.eLevels.INFO,
                message             = "",
            };
        }

        public static LEVEL = BaseLog.eLevels;

        protected entries = null;

        protected path = "";

        protected AutoWrite = false;

        protected dateTimeFunction = null;

        protected callbacks = {
        onLog                   = false,
    };

        protected Level = BaseLog.eLevels.INFO;

        --[[!
        @fqxn LuaEx.Classes.BaseLog.getAutoWrite
        @desc Retains the legacy public accessor without exposing protected storage.
        !]]
        public getAutoWrite() { return this.AutoWrite; }

        --[[!
        @fqxn LuaEx.Classes.BaseLog.setAutoWrite
        @desc Changes automatic writing through the typed protected binding.
        !]]
        public setAutoWrite(bValue) { this.AutoWrite = bValue; }

        --[[!
        @fqxn LuaEx.Classes.BaseLog.getLevel
        @desc Retains the final getter generated by the former auto directive.
        !]]
        public final getLevel() { return this.Level; }

        --[[!
        @fqxn LuaEx.Classes.BaseLog.setLevel
        @desc Retains the final setter generated by the former auto directive.
        !]]
        public final setLevel(eValue) { this.Level = eValue; }

        --PUBLIC
            --[[!
            @fqxn LuaEx.Classes.BaseLog.BaseLog
            @pulsarlua function BaseLog
            @desc The constructor for the log class.
            @param string pFile The path to the log file (or where it should be created).
            @param boolean|nil bDoNotAutoWrite If set to true, it prevents autowriting to file. This can be changed at anytime by setting the autowrite value.
            !]]
        public BaseLog(pFile, fDateTime, fOnLogCallback, bDoNotAutoWrite)
        {
            local pro = this;
            type.assert.string(pFile, "%S+");
            type.assert["function"](fDateTime);

            -- Open the file in append mode
            local hFile = io.open(pFile, "a")

            -- Check if the file was successfully opened
            if not (hFile) then
                error("Error createing BaseLog instance. Path is invalid or file could not be opened.");
                --TODO auto import old from file...?
            end

            hFile:close();

            pro.AutoWrite        = not (rawtype(bDoNotAutoWrite) == "boolean" and bDoNotAutoWrite or false);
            pro.dateTimeFunction = fDateTime;
            pro.path             = pFile;
            pro.callbacks.onLog  = rawtype(fOnLogCallback) == "function" and fOnLogCallback or false;

            local tEntries = {};
            this.entries = tEntries;

            --create the log entires table
            for nIndex, eLevel in BaseLog.eLevels() do
                tEntries[eLevel] = {};
            end
        }

        --TODO FINISH clear (memory) and purge(file) methods

            --[[!
            @fqxn LuaEx.Classes.BaseLog.getLogLevel
            @pulsarlua function BaseLog.log
            @desc Returns the current <a href="#LuaEx.Classes.BaseLog.Enums.LEVEL">BaseLog.LEVEL</a> that's used by default.
            @ret Log.LEVEL eLevel The current <a href="#LuaEx.Classes.BaseLog.Enums.LEVEL">Log.LEVEL</a>.
            !]]


            --[[!
            @fqxn LuaEx.Classes.BaseLog.log
            @pulsarlua function BaseLog.log
            @desc Creates a log entry and writes it to file (if autowrite is true).
            @param string sMessage The message of the log entry.
            @param Log.LEVEL|nil eLevel The <a href="#LuaEx.Classes.BaseLog.Enums.LEVEL">Log.LEVEL</a> enum item to use for the entry. If nil, it will use the current <a href="#LuaEx.Classes.BaseLog.Enums.LEVEL">Log.LEVEL</a>.
            !]]
        public log(sMessage, eLevel)
        {
            local pro = this;
            eLevel = type(eLevel) == "BaseLog.LEVEL" and eLevel or pro.Level;
            type.assert.string(sMessage, "%S+");

            local tEntries = pro.entries;

            local tEntry = {
                datetime            = pro.dateTimeFunction(),
                hasBeenCommitted    = false, --track which entries have been written to file
                level               = eLevel,
                message             = sMessage,
            };

            tEntries[eLevel][#tEntries[eLevel] + 1] = tEntry;

            if (pro.AutoWrite) then
                BaseLog.helperWriteToFile(this, tEntry);
            end
        }

        --[[!
        @fqxn LuaEx.Classes.BaseLog.purge
        @desc Retains the existing BaseLog operation.
        !]]
        public purge()
        {
            local pro = this;
            local hFile = io.open(pro.path, "w");

            if hFile then
                hFile:write('');
                hFile:close();
            end
        }

        --[[!
        @fqxn LuaEx.Classes.BaseLog.setLogLevel
        @pulsarlua function BaseLog.writeToFile
        @desc Sets the current <a href="#LuaEx.Classes.BaseLog.Enums.LEVEL">Log.LEVEL</a> that's used by default.
        @param Log.LEVEL eLevel The <a href="#LuaEx.Classes.BaseLog.Enums.LEVEL">Log.LEVEL</a> to set as current.
        !]]
        public writeToFile()
        {
            --TODO FINISH
        }

    }
}
